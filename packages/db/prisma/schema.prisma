// PRD v0.4 — QR 기반 소규모 매장 근태관리 SaaS
// 규칙
// - 시각은 UTC timestamptz 저장, 계산·분할은 Store.timezone 기준
// - 금액은 원 단위 Int
// - Prisma가 표현 못 하는 제약(부분 유니크, CHECK, 기간 겹침 금지)은
//   migrations/0001_constraints/migration.sql 에 raw SQL로 둔다

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE // 퇴사·비활성. 기록 유지, 과금 제외
}

enum Permission {
  PAYROLL_READ // Manager에게 급여·시급 조회 위임
  TERMS_EDIT // Manager에게 근로조건 수정 위임
}

enum InvitationKind {
  JOIN // 새 직원
  REREGISTER // 기존 직원 기기 재등록 (폰 교체·퇴사 후 복귀)
}

enum PlaceProvider {
  KAKAO
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum HeadcountBand {
  UNDER_5
  FIVE_OR_MORE
  UNKNOWN
}

enum AttendanceStatus {
  OPEN // 근무 중
  CLOSED // 정상 종료
  MISSING_CLOCK_OUT // 퇴근 누락 자동 전환
  VOID // 관리자 무효 처리
}

enum CorrectionType {
  TIME // 출퇴근 시각 수정
  BREAK_WAIVED // 휴게 못 함
  MISSING_CLOCK_OUT // 퇴근 누락 시각 입력
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum LaborReviewType {
  MINIMUM_WAGE
  BREAK_SHORTAGE
  WEEKLY_HOLIDAY
  SHORT_TIME_OVERTIME
  NIGHT_WORK
  OVERTIME
  HOLIDAY_WORK // P1
  ABSENCE_SUSPECTED
  SEVERANCE // P1
  ANNUAL_LEAVE // P1
}

enum LaborReviewStatus {
  OPEN
  NEEDS_INFORMATION
  ACKNOWLEDGED // 관리자가 안내를 확인함. 지급 의무가 없다는 뜻이 아니다
  RESOLVED // 근로조건 변경으로 해소
  SUPERSEDED // 새 근로조건 버전으로 대체
}

enum LaborReviewSource {
  EMPLOYMENT_TERMS
  ATTENDANCE
  PAY_PERIOD
}

enum SubscriptionPlan {
  PILOT
  BASIC
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayslipStatus {
  DRAFT // 사장님 확인 전
  SENT // 교부됨 (현재 유효본)
  SUPERSEDED // 정정본이 보내져 대체됨
}

enum DeductionType {
  NONE
  WITHHOLDING_3_3
  SOCIAL_INSURANCE
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
}

// ─── 사용자·매장 ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique // E.164
  email     String?  @unique
  kakaoId   String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships            Membership[]
  devices                DeviceCredential[]
  deviceHandoffCodes     DeviceHandoffCode[]
  invitationsCreated     StoreInvitation[]           @relation("InvitationCreatedBy")
  invitationsAccepted    StoreInvitation[]           @relation("InvitationAcceptedBy")
  headcountDeclarations  StoreHeadcountDeclaration[]
  correctionsRequested   CorrectionRequest[]         @relation("CorrectionRequester")
  correctionsDecided     CorrectionRequest[]         @relation("CorrectionDecider")
  attendanceRevisions    AttendanceRevision[]
  laborReviewsAcked      LaborReview[]
  employmentTermsCreated EmploymentTerms[]
  payslipsSent           Payslip[]
  pushTokens             PushToken[]
}

model Store {
  id                             String         @id @default(cuid())
  name                           String
  address                        String?
  latitude                       Float?
  longitude                      Float?
  timezone                       String         @default("Asia/Seoul") // IANA
  payPeriodStartDay              Int            @default(1) // 1~28
  // 시작일 변경은 다음 정산 기간부터. 기준일 이전 기간은 이전 값으로 계산
  previousPayPeriodStartDay      Int?
  payPeriodStartDayEffectiveFrom DateTime?      @db.Date
  // 국세청 상태조회로 확인한 10자리 사업자번호 (선택, docs/specs/store §3.2)
  businessNumber                 String?
  businessVerifiedAt             DateTime?      @db.Timestamptz(3)
  // 가게 검색에서 고른 장소. 운영 중 매장끼리 중복 등록 금지 (raw SQL 부분 유니크)
  placeProvider                  PlaceProvider?
  placeId                        String?
  status                         StoreStatus    @default(ACTIVE)
  // 급여 지급일 1~31 (docs/specs/payslip §3.4). CHECK는 raw SQL
  payDay                         Int?
  createdAt                      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime       @updatedAt @db.Timestamptz(3)

  memberships           Membership[]
  qrTokens              StoreQrToken[]
  invitations           StoreInvitation[]
  headcountDeclarations StoreHeadcountDeclaration[]
  attendances           Attendance[]
  subscriptions         Subscription[]
  payslips              Payslip[]
  qrDesign              StoreQrDesign?
}

model Membership {
  id          String           @id @default(cuid())
  storeId     String
  userId      String
  role        Role
  permissions Permission[]
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  leftAt      DateTime?        @db.Timestamptz(3) // 보관 3년 기산점

  store                 Store             @relation(fields: [storeId], references: [id])
  user                  User              @relation(fields: [userId], references: [id])
  employmentTerms       EmploymentTerms[]
  attendances           Attendance[]
  laborReviews          LaborReview[]
  reregisterInvitations StoreInvitation[]
  payslips              Payslip[]
  shiftReminders        ShiftReminder[]

  @@unique([storeId, userId])
  @@index([userId])
}

model StoreQrToken {
  id              String    @id @default(cuid())
  storeId         String
  tokenHash       String    @unique // SHA-256, 원문 평문 저장 금지
  // AES-256-GCM "v1.<iv>.<ct+tag>". 사장님 재조회용 (docs/specs/qr-card §3.1). 이전 토큰은 null
  tokenCiphertext String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  // 매장당 활성 토큰 1개: raw SQL 부분 유니크
  @@index([storeId])
}

/// QR 카드 레이아웃 (docs/specs/qr-card §4.1)
enum QrCardLayout {
  STAND // 탁상 스탠드 A6 세로 (105×148mm)
  STICKER // 스티커 80×80mm
}

/// 매장 QR 카드 디자인. 재발급해도 그대로 둔다 (docs/specs/qr-card §4.1·§8)
model StoreQrDesign {
  storeId     String       @id
  layout      QrCardLayout @default(STAND)
  color       String       @default("kok") // 프리셋 키 (qr-card §4.2)
  title       String // 1~20자
  message     String // 0~40자
  logo        Bytes? // PNG/JPEG, 200KB 이하 (qr-card §4.3)
  logoMime    String?
  updatedById String // 세션 사용자. User 관계 없이 문자열
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreInvitation {
  id           String         @id @default(cuid())
  storeId      String
  tokenHash    String         @unique
  kind         InvitationKind @default(JOIN)
  role         Role           @default(EMPLOYEE)
  memberId     String? // REREGISTER 대상 Membership
  createdById  String
  expiresAt    DateTime       @db.Timestamptz(3)
  acceptedAt   DateTime?      @db.Timestamptz(3)
  acceptedById String?
  revokedAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  store      Store       @relation(fields: [storeId], references: [id])
  member     Membership? @relation(fields: [memberId], references: [id])
  createdBy  User        @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?       @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([storeId])
}

// 등록된 기기 = 세션. 원문 토큰은 HttpOnly 쿠키에만 있다 (docs/specs/auth §3)
model DeviceCredential {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id])
  pushToken PushToken?

  @@index([userId])
}

// 사업장 규모 신고 이력. 등록 직원 수를 상시근로자 수로 간주하지 않는다
model StoreHeadcountDeclaration {
  id            String        @id @default(cuid())
  storeId       String
  band          HeadcountBand
  effectiveFrom DateTime      @db.Date // 매장 시간대 기준 날짜
  declaredById  String
  note          String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  store      Store @relation(fields: [storeId], references: [id])
  declaredBy User  @relation(fields: [declaredById], references: [id])

  @@unique([storeId, effectiveFrom])
}

// ─── 근로조건 ────────────────────────────────────────────

// 버전은 불변. 수정은 새 버전 생성 + 이전 버전 effectiveTo 설정
model EmploymentTerms {
  id                           String        @id @default(cuid())
  membershipId                 String
  version                      Int
  effectiveFrom                DateTime      @db.Timestamptz(3)
  effectiveTo                  DateTime?     @db.Timestamptz(3) // 미포함 경계
  hourlyWage                   Int // 원
  scheduleVaries               Boolean       @default(false) // 주마다 다름
  averageWeeklyMinutesOverride Int? // scheduleVaries일 때 4주 평균
  weeklyHolidayWeekday         Int? // 0=일 ~ 6=토
  contractStartDate            DateTime      @db.Date
  contractEndDate              DateTime?     @db.Date
  deductionType                DeductionType @default(NONE) // 임금명세서 공제 방식 (docs/specs/payslip §3.3)
  createdById                  String
  createdAt                    DateTime      @default(now()) @db.Timestamptz(3)

  membership  Membership                @relation(fields: [membershipId], references: [id])
  createdBy   User                      @relation(fields: [createdById], references: [id])
  schedules   EmploymentTermsSchedule[]
  attendances Attendance[]

  // 같은 직원의 기간 겹침 금지: raw SQL exclusion constraint
  @@unique([membershipId, version])
  @@index([membershipId, effectiveFrom])
}

// 요일별 소정 근무. MVP는 하루 1구간
model EmploymentTermsSchedule {
  id           String @id @default(cuid())
  termsId      String
  weekday      Int // 0=일 ~ 6=토
  startMinute  Int // 매장 시간대 자정 기준 분 (18:00 → 1080)
  workMinutes  Int // 출근~퇴근 구간 길이. 자정 넘김 허용
  breakMinutes Int    @default(0)

  terms EmploymentTerms @relation(fields: [termsId], references: [id], onDelete: Cascade)

  @@unique([termsId, weekday])
}

// ─── 근태 ────────────────────────────────────────────────

model Attendance {
  id                 String           @id @default(cuid())
  storeId            String
  membershipId       String
  termsId            String // 출근 시각에 유효한 근로조건
  clockInAt          DateTime         @db.Timestamptz(3)
  clockOutAt         DateTime?        @db.Timestamptz(3)
  status             AttendanceStatus @default(OPEN)
  clockInLatitude    Float?
  clockInLongitude   Float?
  clockInAccuracyM   Int?
  clockInOutsideArea Boolean? // 표시용. 차단하지 않는다
  breakWaived        Boolean          @default(false) // "휴게 못 함" 승인
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  store       Store                @relation(fields: [storeId], references: [id])
  membership  Membership           @relation(fields: [membershipId], references: [id])
  terms       EmploymentTerms      @relation(fields: [termsId], references: [id])
  corrections CorrectionRequest[]
  revisions   AttendanceRevision[]
  breaks      AttendanceBreak[]

  // 직원당 OPEN 1개: raw SQL 부분 유니크
  @@index([storeId, clockInAt])
  @@index([membershipId, clockInAt])
  @@index([status])
}

model CorrectionRequest {
  id                 String           @id @default(cuid())
  attendanceId       String
  requesterId        String
  type               CorrectionType
  proposedClockInAt  DateTime?        @db.Timestamptz(3)
  proposedClockOutAt DateTime?        @db.Timestamptz(3)
  reason             String
  status             CorrectionStatus @default(PENDING)
  decidedById        String?
  decidedAt          DateTime?        @db.Timestamptz(3)
  decisionNote       String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  attendance Attendance           @relation(fields: [attendanceId], references: [id])
  requester  User                 @relation("CorrectionRequester", fields: [requesterId], references: [id])
  decidedBy  User?                @relation("CorrectionDecider", fields: [decidedById], references: [id])
  revisions  AttendanceRevision[]

  @@index([attendanceId])
  @@index([status, createdAt])
}

/// 직원이 직접 남긴 실제 휴게 (docs/specs/attendance §3.6). 근무당 여러 번, 열린 휴게는 1개(raw SQL 부분 유니크)
model AttendanceBreak {
  id           String    @id @default(cuid())
  attendanceId String
  startAt      DateTime  @db.Timestamptz(3)
  endAt        DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId, startAt])
}

// 근태 변경 감사 로그. 승인·관리자 직접 수정 모두 기록
model AttendanceRevision {
  id                  String   @id @default(cuid())
  attendanceId        String
  actorId             String
  before              Json
  after               Json
  reason              String
  correctionRequestId String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  attendance        Attendance         @relation(fields: [attendanceId], references: [id])
  actor             User               @relation(fields: [actorId], references: [id])
  correctionRequest CorrectionRequest? @relation(fields: [correctionRequestId], references: [id])

  @@index([attendanceId, createdAt])
}

// RN 앱 셸 ↔ WebView 기기 세션 교환용 1회용 코드 (docs/specs/auth §6.2). 원문은 저장하지 않는다
model DeviceHandoffCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

// 휴대폰 인증번호. 코드 원문 저장 금지
model OtpCode {
  id         String    @id @default(cuid())
  phone      String // E.164
  codeHash   String
  attempts   Int       @default(0) // 5회 초과 시 폐기
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  // 재발송 간격·일일 횟수 조회
  @@index([phone, createdAt])
}

// punch 재시도 시 같은 결과 반환 (24시간)
model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  requestHash    String // 같은 키에 다른 body가 오면 422
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([expiresAt])
}

// ─── 법정 검토 ───────────────────────────────────────────

model LaborReview {
  id               String            @id @default(cuid())
  membershipId     String
  type             LaborReviewType
  status           LaborReviewStatus @default(OPEN)
  sourceType       LaborReviewSource
  sourceId         String // 다형 참조라 FK 없음
  ruleVersion      String
  reasonCode       String
  acknowledgedById String?
  acknowledgedAt   DateTime?         @db.Timestamptz(3)
  seenAt           DateTime?         @db.Timestamptz(3) // 바텀시트 1회 노출 기록
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  membership     Membership @relation(fields: [membershipId], references: [id])
  acknowledgedBy User?      @relation(fields: [acknowledgedById], references: [id])

  // 같은 사유 재노출 방지. 규칙 버전이 바뀌면 새 행으로 재평가
  @@unique([membershipId, type, sourceType, sourceId, ruleVersion])
  @@index([membershipId, status])
}

// 최저임금·가산 비율 등 규칙 데이터. 코드 하드코딩 금지
model LaborRuleSet {
  id                String   @id @default(cuid())
  version           String   @unique // "2026.1"
  effectiveFrom     DateTime @db.Date
  minimumHourlyWage Int // 원
  rules             Json
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([effectiveFrom])
}

// ─── 구독 ────────────────────────────────────────────────

model Subscription {
  id                  String             @id @default(cuid())
  storeId             String
  plan                SubscriptionPlan
  status              SubscriptionStatus
  periodStart         DateTime           @db.Timestamptz(3)
  periodEnd           DateTime           @db.Timestamptz(3)
  billedActiveMembers Int? // 청구 월 출근 기록 1건 이상 인원, 청구 시 확정
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, periodStart])
}

// ─── 임금명세서 (docs/specs/payslip §4.1) ────────────────

// SENT·SUPERSEDED는 불변. 같은 (membershipId, periodStart)에 DRAFT는 최대 1개 (raw SQL 부분 유니크)
model Payslip {
  id                String        @id @default(cuid())
  storeId           String
  membershipId      String
  periodStart       DateTime      @db.Date
  periodEnd         DateTime      @db.Date // 미포함
  version           Int // 1 = 최초, 2부터 정정본
  status            PayslipStatus @default(DRAFT)
  payDate           DateTime?     @db.Date
  // 보낼 때 고정되는 스냅숏. 사원번호 = 매장 안 Membership을 (joinedAt, id) 순으로 센 순번
  employeeName      String
  employeeNumber    Int
  workDays          Int
  recognizedSeconds Int
  overtimeSeconds   Int
  nightSeconds      Int
  holidaySeconds    Int
  deductionType     DeductionType
  grossPay          Int
  totalDeduction    Int
  netPay            Int
  correctionNote    String? // 정정본일 때 직원에게 보이는 사유
  sentAt            DateTime?     @db.Timestamptz(3)
  sentById          String?
  viewedAt          DateTime?     @db.Timestamptz(3) // 직원이 처음 연 시각
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  store      Store         @relation(fields: [storeId], references: [id])
  membership Membership    @relation(fields: [membershipId], references: [id])
  sentBy     User?         @relation(fields: [sentById], references: [id])
  lines      PayslipLine[]

  @@unique([membershipId, periodStart, version])
  @@index([storeId, periodStart])
}

model PayslipLine {
  id               String          @id @default(cuid())
  payslipId        String
  kind             PayslipLineKind
  code             String // §3.2·§3.3 code
  label            String
  basis            String // 계산방법 문구
  calculatedAmount Int? // 시스템 계산값. CUSTOM·수기 공제는 null
  amount           Int // 최종 금액
  adjustReason     String? // amount ≠ calculatedAmount 이면 필수
  sortOrder        Int

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

// 기기 1대 = FCM 토큰 1개 (docs/specs/payslip §6)
// 출퇴근 알림 발송 기록. 유니크로 중복 발송을 막는다 (docs/specs/notifications §5)
enum ShiftReminderKind {
  START_SOON // 소정 출근 10분 전
  START_NOW // 소정 출근
  END_SOON // 소정 퇴근 10분 전
  END_NOW // 소정 퇴근
}

model ShiftReminder {
  id           String            @id @default(cuid())
  membershipId String
  kind         ShiftReminderKind
  scheduledAt  DateTime          @db.Timestamptz(3) // 알림 시각 (소정 출근·퇴근 또는 그 10분 전)
  sentAt       DateTime          @db.Timestamptz(3) // 배치가 발송을 맡은 시각

  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, kind, scheduledAt])
}

model PushToken {
  id                 String   @id @default(cuid())
  deviceCredentialId String   @unique
  userId             String
  token              String   @unique // FCM registration token
  platform           String // 'ios' | 'android'
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  deviceCredential DeviceCredential @relation(fields: [deviceCredentialId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id])

  @@index([userId])
}
