# Postgres (확장 btree_gist 필요). 로컬 개발은 PGlite 파일 DB: "pglite:../../packages/db/.pglite"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chulgeunkok"

# 개발용 임시 로그인. "1"이면 x-dev-user-id 헤더·dev_user_id 쿠키를 세션으로 쓴다. production에서는 무시
DEV_AUTH="0"

# QR·초대 링크 도메인
APP_ORIGIN="http://localhost:3000"

# 매장 QR 원문 암호화 키 (AES-256-GCM, 32바이트 base64). 생성: openssl rand -base64 32
# 비어 있으면 개발용 고정 키를 쓴다 (production에서는 오류). docs/specs/qr-card §3.1
QR_TOKEN_ENC_KEY=

# 외부 연동. 비어 있으면 개발용 응답을 쓴다 (production에서는 오류)
# 카카오 디벨로퍼스 > 내 애플리케이션 > REST API 키
KAKAO_REST_API_KEY=""
# 공공데이터포털 > 국세청_사업자등록정보 진위확인 및 상태조회 서비스 > 일반 인증키(Decoding)
NTS_SERVICE_KEY=""
# SMS 발송: dev(로그만 출력). 공급자 계약 후 추가
SMS_PROVIDER="dev"
# 푸시 발송: dev(로그만 출력) | fcm(firebase-admin). docs/specs/payslip §6
PUSH_PROVIDER="dev"
# fcm일 때 Firebase 서비스 계정 JSON 한 줄 (시크릿)
FIREBASE_SERVICE_ACCOUNT=

# 내부 배치 호출 비밀값 (/api/internal/jobs/*). 비어 있으면 배치를 실행할 수 없다
CRON_SECRET=""
