{
  "name": "chulgeunkok",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chulgeunkok/web dev",
    "build": "pnpm --filter @chulgeunkok/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:dev": "pnpm --filter @chulgeunkok/db dev:db",
    "db:migrate": "pnpm --filter @chulgeunkok/db migrate",
    "db:validate": "pnpm --filter @chulgeunkok/db validate",
    "db:verify": "pnpm --filter @chulgeunkok/db verify:constraints"
  }
}
